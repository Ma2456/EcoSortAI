# Copy to backend/.env and adjust.
ECOSORT_BACKEND=custom
ECOSORT_MODEL_CONFIG=model/model_config.json
ECOSORT_DEVICE=auto
ECOSORT_EXPLAINERS=gradcam,lime,shap
ECOSORT_LIME_SAMPLES=300
ECOSORT_SHAP_SAMPLES=300
ECOSORT_MAX_UPLOAD_MB=10
ECOSORT_DETECTOR_WEIGHTS=model/ecosortai_yolov8_best.pt
ECOSORT_DETECTOR_CONF=0.25
ECOSORT_MAX_OBJECTS=6
# "null" = the single-file EcoSortAI.html opened from disk
ECOSORT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,null

# Performance Evaluation (optional)
# ECOSORT_EVAL_MAX_DATASET_MB=2048
# ECOSORT_EVAL_MAX_FILES=20000
# ECOSORT_EVAL_RUNS_DIR=evaluation_runs
